# Loops (loops.so) — used by app/api/drop-list/route.ts to add signups to
# the audience. Without this set, signups are still accepted but just logged
# to the console instead of sent to Loops.
#
# Abu's welcome email is a Loops Workflow (not called from this code at all)
# configured in the dashboard to trigger automatically whenever a contact is
# added — so adding the contact via the API is what sets it off. Its
# subject/body should match WELCOME_TEXT/WELCOME_SUBJECT/WELCOME_FROM in
# app/api/drop-list/route.ts.

# Settings → API in the Loops dashboard.
LOOPS_API_KEY=

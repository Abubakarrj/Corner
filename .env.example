# Twilio credentials for the drop-list welcome text (app/api/drop-list/route.ts).
# Without these set, signups still succeed — the welcome text is just skipped,
# with a warning in the server log.
#
# From the Twilio Console (https://console.twilio.com):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# An SMS-capable Twilio number in E.164 format, e.g. +14155550123.
TWILIO_FROM_NUMBER=

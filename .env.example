# Loops (loops.so) — used by app/api/drop-list/route.ts to add signups to
# the audience and send Abu's welcome email. Without these set, signups are
# still accepted but just logged to the console instead of sent.

# Settings → API in the Loops dashboard.
LOOPS_API_KEY=

# The ID of the "Abu welcome" Transactional Email template, created in the
# Loops dashboard (Transactional → your template → copy the ID). The
# template's subject/body should match WELCOME_TEXT in
# app/api/drop-list/route.ts.
LOOPS_WELCOME_TRANSACTIONAL_ID=

# Google Sheets — used by app/api/catering/route.ts to append each catering
# inquiry as a row. Without these set, inquiries are still accepted but just
# logged to the console instead of written anywhere.
#
# Setup:
#  1. In Google Cloud Console, create (or reuse) a project, enable the
#     "Google Sheets API", then create a Service Account and generate a JSON
#     key for it.
#  2. Open the target spreadsheet and share it with the service account's
#     email (client_email in the JSON key) as an Editor.
#  3. Create a tab named "Catering" in that sheet (or set
#     GOOGLE_SHEETS_RANGE below to match whatever tab you use).

# client_email from the downloaded JSON key.
GOOGLE_SHEETS_CLIENT_EMAIL=

# private_key from the downloaded JSON key. Paste it on one line with
# literal \n in place of real newlines — that's how it already appears in
# the JSON file's "private_key" field, so copying that string as-is works.
GOOGLE_SHEETS_PRIVATE_KEY=

# The spreadsheet's ID — the long string in its URL between /d/ and /edit.
GOOGLE_SHEETS_SPREADSHEET_ID=

# Sheet tab + column range to append into. Optional — defaults to
# "Catering!A:G" (timestamp, name, email, phone, event date, guest count,
# details) if unset.
GOOGLE_SHEETS_RANGE=

# Loops (loops.so) — used by app/api/drop-list/route.ts to add signups to
# the audience and send Abu's welcome email. Without these set, signups are
# still accepted but just logged to the console instead of sent.

# Settings → API in the Loops dashboard.
LOOPS_API_KEY=

# The ID of the "Abu welcome" Transactional Email template, created in the
# Loops dashboard (Transactional → your template → copy the ID). The
# template's subject/body should match WELCOME_TEXT in
# app/api/drop-list/route.ts.
LOOPS_WELCOME_TRANSACTIONAL_ID=
